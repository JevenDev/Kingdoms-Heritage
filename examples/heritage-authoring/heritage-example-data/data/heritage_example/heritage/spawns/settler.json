{
  "title": "Settler",
  "description": "Begin inside a village. Pick a farming kit or travel light.",
  "type": "structure",
  "target": "#minecraft:village",
  "search_radius": 6400,
  "order": 40,
  "intro": {
    "text": "A <gold>{structure|new settlement}</gold> waits for you, {player}.",
    "subtitle": "{biome} / {dimension}\nChosen kit: {kit}. You bring {equipment}.\n{var:heritage_example:guide}: Press {key:inventory} to look inside.",
    "title_position": "left_center",
    "subtitle_position": "left_center",
    "cinematic_bars": true,
    "bar_style": "random",
    "hide_hud_during_bars": true,
    "outline": true,
    "black_hold_ticks": 60,
    "fade_from_black_ticks": 60,
    "animation": "letter_by_letter",
    "reveal_ticks": 40,
    "hold_ticks": 60,
    "fade_out_ticks": 20,
    "control": "after_title",
    "blip": true,
    "title": true,
    "fallbacks": {
      "var:heritage_example:guide": {
        "translate": "heritage_example.dialogue.guide",
        "fallback": "A local guide",
        "color": "green"
      }
    },
    "variants": [
      {
        "when": {
          "tag": "keeps_belongings",
          "equals": true
        },
        "subtitle": "{var:heritage_example:guide}: Your belongings made the journey.\nPress {key:inventory} to see {equipment}."
      },
      {
        "when": {
          "all": [
            {
              "tag": "kit",
              "equals": "heritage_example:farmer"
            },
            {
              "tag": "receives_kit",
              "equals": true
            }
          ]
        },
        "subtitle": "{var:heritage_example:guide}: The fields need a farmer.\nYour {kit} supplies are ready. Press {key:inventory}."
      }
    ]
  },
  "title_key": "heritage_example.spawn.settler.title",
  "image": "heritage_example:textures/gui/locations/settler.png",
  "kits": [
    "#heritage_example:starter"
  ]
}
