{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage starter kit",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "if": {
    "required": [
      "enabled"
    ],
    "properties": {
      "enabled": {
        "const": false
      }
    }
  },
  "else": {
    "anyOf": [
      { "required": ["items"] },
      { "required": ["shop"] }
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 120,
        "minLength": 1,
        "pattern": "\\S"
      },
      "title_key": {
        "type": "string",
        "maxLength": 256
      },
      "description": {
        "type": "string",
        "maxLength": 4000,
        "default": ""
      },
      "description_key": {
        "type": "string",
        "maxLength": 256
      },
      "order": {
        "type": "integer",
        "default": 0
      },
      "selected_slot": {
        "type": "integer",
        "minimum": 0,
        "maximum": 8,
        "default": 0
      },
      "tags": {
        "type": "array",
        "maxItems": 128,
        "items": {
          "type": "string",
          "pattern": "^(?:[a-z0-9_.-]+:)?[a-z0-9/._-]+$"
        },
        "default": []
      },
      "shop": {
        "type": "object",
        "required": ["budget", "offers"],
        "properties": {
          "budget": { "type": "integer", "minimum": 0, "maximum": 1000000, "description": "Points available to each player for this kit." },
          "sections": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "required": ["id", "name", "icon"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
                "name": { "type": "string", "maxLength": 120, "pattern": "\\S", "description": "Tooltip shown for the section tab." },
                "icon": { "type": "string", "pattern": "^(?:[a-z0-9_.-]+:)?[a-z0-9/._-]+$", "description": "Item ID used for the section tab icon." }
              }
            }
          },
          "offers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "required": ["cost", "item"],
              "properties": {
                "cost": { "type": "integer", "minimum": 0, "maximum": 1000000, "description": "Price for the entire item stack. Use zero for a free offer." },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 41,
                  "default": 1,
                  "description": "Maximum stacks of this offer each player can select."
                },
                "section": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$", "description": "ID of a shop section. All offers are also shown on the All tab." },
                "position": {
                  "type": "object",
                  "description": "Optional slot in this offer's section, counting from 1. Unpositioned offers follow the positioned columns. Empty slots within a column remain empty, and wholly empty columns are skipped.",
                  "required": ["row", "column"],
                  "properties": {
                    "row": { "type": "integer", "minimum": 1, "maximum": 8 },
                    "column": { "type": "integer", "minimum": 1, "maximum": 256 }
                  }
                },
                "item": { "$ref": "#/$defs/stack" }
              }
            }
          }
        }
      },
      "items": {
        "type": "array",
        "maxItems": 256,
        "items": {
          "$ref": "#/$defs/itemEntry"
        },
        "description": "Items for player or equipment slots. Do not repeat the same inventory, slot, index and cosmetic settings."
      }
    },
    "allOf": [
      {
        "anyOf": [
          {
            "required": [
              "title"
            ]
          },
          {
            "required": [
              "title_key"
            ],
            "properties": {
              "title_key": {
                "type": "string",
                "maxLength": 120,
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        ]
      }
    ]
  },
  "$defs": {
    "stack": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:[a-z0-9_.-]+:)?[a-z0-9/._-]+$"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "components": {
          "type": "object"
        }
      },
      "description": "Minecraft 1.21.1 item data. The game checks the item components and stack limit."
    },
    "itemEntry": {
      "type": "object",
      "required": [
        "index",
        "item"
      ],
      "properties": {
        "inventory": {
          "type": "string",
          "enum": [
            "player",
            "curios",
            "accessories"
          ],
          "default": "player"
        },
        "slot": {
          "type": "string",
          "maxLength": 128,
          "default": ""
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "ignore_stack_limit": {
          "type": "boolean",
          "default": false,
          "description": "Skip the vanilla stack limit for this item in the authoring tools. Minecraft still checks the actual stack limit in the installed modpack."
        },
        "cosmetic": {
          "type": "boolean",
          "default": false
        },
        "item": { "$ref": "#/$defs/stack" }
      },
      "if": {
        "properties": {
          "inventory": {
            "const": "player"
          }
        }
      },
      "then": {
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 40
          },
          "slot": {
            "const": ""
          },
          "cosmetic": {
            "const": false
          }
        }
      },
      "else": {
        "required": [
          "slot"
        ],
        "properties": {
          "slot": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
